APP_NAME=btcObserver
ENV=dev
LOG_LEVEL=INFO

POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=btc_observer
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

REDIS_ENABLED=true
REDIS_URL=redis://redis:6379/0

SCHEDULER_TIMEZONE=UTC
BACKFILL_ON_STARTUP=true
REQUEST_TIMEOUT_SECONDS=20
RATE_LIMIT_PER_MINUTE=60

# Required for Phase 1 macro ingestion (register free key at fred.stlouisfed.org)
FRED_API_KEY=__REQUIRED__
COINGECKO_API_KEY=
GLASSNODE_API_KEY=
COIN_METRICS_API_KEY=

CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
DISCLAIMER_TEXT=本看板仅供信息参考，不构成任何投资建议。

NEXT_PUBLIC_API_BASE=http://localhost:8000
INTERNAL_API_BASE=http://backend:8000
